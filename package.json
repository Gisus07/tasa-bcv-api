{
  "name": "tasa-bcv-api",
  "version": "1.1.0",
  "description": "Public REST API for the official BCV (Banco Central de Venezuela) exchange rate history.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "jobs:backfill": "tsx src/jobs/runner.ts backfill",
    "jobs:daily": "tsx src/jobs/runner.ts daily",
    "jobs:intervention-backfill": "tsx src/jobs/runner.ts intervention-backfill"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/zod-openapi": "^0.19.10",
    "@scalar/hono-api-reference": "^0.5.165",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.4.2",
    "node-cron": "^4.5.0",
    "p-limit": "^7.3.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "undici": "^8.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.6"
  }
}
