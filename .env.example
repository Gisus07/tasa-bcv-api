# PostgreSQL connection string
# Railway injects this automatically when the Postgres plugin is attached.
DATABASE_URL=postgresql://user:password@localhost:5432/tasa_bcv_api

# Application
PORT=3000
NODE_ENV=development
TZ=America/Caracas
LOG_LEVEL=info

# BCV upstream sources (overridable for tests)
BCV_USD_URL=https://www.bcv.org.ve/sites/default/files/indicadores_sector_externo/2_1_1_tdc.xlsx
BCV_EUR_URL_TEMPLATE=https://www.bcv.org.ve/sites/default/files/EstadisticasGeneral/2_1_2{trim}{yy}_otrasmonedas.xls

# Scheduling (cron syntax, runs in TZ above)
CRON_DAILY_AT=0 0 * * 1-5
CRON_RETRY_AT=0 8 * * 1-5

# Backfill control
RUN_BACKFILL_ON_BOOT=false

# Rate limiting
RATE_LIMIT_PER_MIN=30
# Trusted reverse-proxy hops in front of the app (Railway edge = 1). Used to
# pick the real client IP from X-Forwarded-For for rate-limit buckets.
TRUSTED_PROXY_HOPS=1

# Admin endpoint (minimum 32 chars)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-me-with-a-strong-random-token
